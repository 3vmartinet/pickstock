{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // These configurations run against the fvm-managed SDK, which is bound in
    // .vscode/settings.json via "dart.flutterSdkPath". There is no per-launch
    // SDK setting; changing that one setting redirects every entry below.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pickstock (macOS)",
            "request": "launch",
            "type": "dart",
            "deviceId": "macos"
        },
        {
            "name": "pickstock (Linux)",
            "request": "launch",
            "type": "dart",
            "deviceId": "linux"
        },
        {
            "name": "pickstock (mock data, no database)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=PICKSTOCK_MOCK_DATA=true"
            ]
        },
        {
            "name": "pickstock (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "pickstock (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
