{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // These configurations run against the fvm-managed SDK, which is bound in
    // .vscode/settings.json via "dart.flutterSdkPath". There is no per-launch
    // SDK setting; changing that one setting redirects every entry below.
    //
    // `--dart-define-from-file=env.json` supplies the Finnhub API key, which is
    // gitignored. Without it the app runs fine and the share price is typed in;
    // copy env.example.json to env.json and paste a key to get live quotes.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pickstock (macOS)",
            "request": "launch",
            "type": "dart",
            "deviceId": "macos",
            "toolArgs": ["--dart-define-from-file=env.json"]
        },
        {
            // The legacy NVIDIA 390.x driver (Fermi-era GPUs) advertises GLES 3
            // extensions it does not actually implement: samplerExternalOES has
            // no matching texture() overload, and multisampled framebuffers
            // never come back complete. Impeller hits both on its first frame
            // and aborts the process, so this device falls back to Skia. The
            // flag's help text claims it is ignored off Android; that is stale,
            // it does take effect on Linux desktop.
            "name": "pickstock (Linux)",
            "request": "launch",
            "type": "dart",
            "deviceId": "linux",
            "toolArgs": ["--dart-define-from-file=env.json"],
            "args": [
                "--no-enable-impeller"
            ]
        },
        {
            "name": "pickstock (mock data, no database)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=PICKSTOCK_MOCK_DATA=true"
            ]
        },
        {
            "name": "pickstock (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": ["--dart-define-from-file=env.json"]
        },
        {
            "name": "pickstock (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": ["--dart-define-from-file=env.json"]
        }
    ]
}
