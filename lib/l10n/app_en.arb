  "targetsHowTitle": "How these are worked out",
  "targetsHowStep1Title": "A year of cash to start from",
  "targetsHowStep1Body": "Its last year sold {revenue}. Over the years on file it has turned {margin} of what it sells into spare cash, so the sum starts from {flow} — its own typical conversion, not one unusual year.",
  "@targetsHowStep1Body": { "placeholders": { "revenue": { "type": "String" }, "margin": { "type": "String" }, "flow": { "type": "String" } } },
  "targetsHowStep2Title": "Three rates it has actually managed",
  "targetsHowStep2Body": "Its revenue grew {rates} in the {years} years on file. Its worst year gives the bear case at {bear}, its middle year the neutral at {neutral}, and its best year the bull at {bull}. Nothing here is forecast — these are years it has already had.",
  "@targetsHowStep2Body": { "placeholders": { "rates": { "type": "String" }, "years": { "type": "String" }, "bear": { "type": "String" }, "neutral": { "type": "String" }, "bull": { "type": "String" } } },
  "targetsHowStep3Title": "Ten years of it, then the long run",
  "targetsHowStep3Body": "Each rate is grown out for ten years, fading to {terminal} a year by the end — nothing outgrows the economy for ever. Every year's cash is then discounted at {discount}, because money you get later is worth less than money you have now: a dollar arriving in ten years counts as {tenYear} today. The years after that are valued as one lump on the same terms.",
  "@targetsHowStep3Body": { "placeholders": { "terminal": { "type": "String" }, "discount": { "type": "String" }, "tenYear": { "type": "String" } } },
  "targetsHowStep4Title": "Split across the shares",
  "targetsHowStep4Body": "That total, divided by {shares} shares, is what one share is worth under each reading: {bear} bear, {neutral} neutral, {bull} bull.",
  "@targetsHowStep4Body": { "placeholders": { "shares": { "type": "String" }, "bear": { "type": "String" }, "neutral": { "type": "String" }, "bull": { "type": "String" } } },
