  "napkinCaveatTitle": "Worth knowing",
  "napkinCaveatBuilding": "It spent {ratio}× more on equipment than wore out, so last year's leftover cash understates what the business normally makes. The section below uses a smoothed figure instead.",
  "@napkinCaveatBuilding": { "placeholders": { "ratio": { "type": "String" } } },
