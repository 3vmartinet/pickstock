  "napkinTitle": "How this was worked out",
  "napkinSubtitle": "The whole calculation, in the order it happens.",

  "napkinStep1Title": "Buying the whole company",
  "napkinStep1Body": "A share costs {price}. There are {shares} of them, so buying every share costs {marketCap}. That is what the market says the company is worth.",
  "@napkinStep1Body": {
    "placeholders": {
      "price": { "type": "String" },
      "shares": { "type": "String" },
      "marketCap": { "type": "String" }
    }
  },

  "napkinStep2Title": "What you get for it",
  "napkinStep2Body": "In one year the company took in {revenue} and, after every bill including new equipment, had {freeCashFlow} left over. That is one year's spare cash — what it earns annually, not a pile it has saved up.",
  "@napkinStep2Body": {
    "placeholders": {
      "revenue": { "type": "String" },
      "freeCashFlow": { "type": "String" }
    }
  },

  "napkinStep3TitleDebt": "It owes money, and that is already counted",
  "napkinStep3TitleCash": "It holds spare cash",
  "napkinStep3BodyDebt": "The company owes {netDebt} more than it holds. Its lenders are paid before the owners are, and that interest already came out of the {freeCashFlow} above — so the cash figure is what is left for you after the debt has taken its cut.",
  "@napkinStep3BodyDebt": {
    "placeholders": {
      "netDebt": { "type": "String" },
      "freeCashFlow": { "type": "String" }
    }
  },
  "napkinStep3BodyCash": "The company holds {netCash} more than it owes, so nothing is being siphoned off to lenders. The whole {freeCashFlow} above belongs to the owners.",
  "@napkinStep3BodyCash": {
    "placeholders": {
      "netCash": { "type": "String" },
      "freeCashFlow": { "type": "String" }
    }
  },

  "napkinStep4Title": "How many years of cash is that?",
  "napkinStep4Body": "{marketCap} to buy every share, ÷ {freeCashFlow} earned each year = {years} years to get your money back, if the company never grows. The same question as asking how many years' rent a flat costs.",
  "@napkinStep4Body": {
    "placeholders": {
      "marketCap": { "type": "String" },
      "freeCashFlow": { "type": "String" },
      "years": { "type": "String" }
    }
  },

  "napkinStep5Title": "How many years is fair?",
  "napkinStep5BodyFlat": "Wanting {discount} a year back, a business going nowhere is worth about {flat} years of its cash — that is simply what those years add up to once each one is discounted. This one is not growing, so it gets no more than that.",
  "@napkinStep5BodyFlat": { "placeholders": { "discount": { "type": "String" }, "flat": { "type": "String" } } },
  "napkinStep5BodyGrowing": "Wanting {discount} a year back, a business going nowhere is worth about {flat} years of its cash. This one grew {growth} in its middle year of the last {years} — the median, so one exceptional year cannot set the price. Next year's cash should be bigger than this year's, so it is worth more: {low} to {high} years, the range being what a point either side of {discount} does to the answer.",
  "@napkinStep5BodyGrowing": {
    "placeholders": {
      "discount": { "type": "String" },
      "flat": { "type": "String" },
      "growth": { "type": "String" },
      "years": { "type": "String" },
      "low": { "type": "String" },
      "high": { "type": "String" }
    }
  },

  "napkinStep6Title": "So what is a share worth?",
  "napkinStep6Body": "{low} to {high} years of {basis} is {valueLow} to {valueHigh} for the whole company. Divide by {shares} shares, and one share is worth {rangeLow} to {rangeHigh}.",
  "@napkinStep6Body": {
    "placeholders": {
      "low": { "type": "String" },
      "high": { "type": "String" },
      "basis": { "type": "String" },
      "valueLow": { "type": "String" },
      "valueHigh": { "type": "String" },
      "shares": { "type": "String" },
      "rangeLow": { "type": "String" },
      "rangeHigh": { "type": "String" }
    }
  },

  "napkinStep7Title": "And the answer",
  "napkinStep7BodyUnder": "You are paying {price}, below the {rangeLow}–{rangeHigh} the earnings support. That is the cheap side.",
  "napkinStep7BodyFair": "You are paying {price}, inside the {rangeLow}–{rangeHigh} the earnings support. That is a normal price.",
  "napkinStep7BodyOver": "You are paying {price}, above the {rangeLow}–{rangeHigh} the earnings support. You are paying for growth that has not happened yet.",
  "@napkinStep7BodyUnder": {
    "placeholders": {
      "price": { "type": "String" },
      "rangeLow": { "type": "String" },
      "rangeHigh": { "type": "String" }
    }
  },
  "@napkinStep7BodyFair": {
    "placeholders": {
      "price": { "type": "String" },
      "rangeLow": { "type": "String" },
      "rangeHigh": { "type": "String" }
    }
  },
  "@napkinStep7BodyOver": {
    "placeholders": {
      "price": { "type": "String" },
      "rangeLow": { "type": "String" },
      "rangeHigh": { "type": "String" }
    }
  },

