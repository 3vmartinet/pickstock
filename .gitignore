# ---------------------------------------------------------------------------
# Dart & Flutter build output
# ---------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub/
.pub-cache/
.pub-preload-cache/
build/
**/doc/api/
**/generated_plugin_registrant.dart
migrate_working_dir/
flutter_*.png
linked_*.ds
unlinked.ds
unlinked_spec.ds

# Symbolication and obfuscation artefacts
app.*.symbols
app.*.map.json

# Test coverage
coverage/

# ---------------------------------------------------------------------------
# Toolchain
# ---------------------------------------------------------------------------
# fvm keeps the pinned SDK here as a symlink; .fvmrc is committed instead.
.fvm/

# ---------------------------------------------------------------------------
# Editors & IDEs
# ---------------------------------------------------------------------------
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder holds launch configurations and settings that are worth
# sharing, so it is deliberately committed.
#.vscode/

.atom/
.history
.swiftpm/
*.swp

# ---------------------------------------------------------------------------
# Operating system & misc
# ---------------------------------------------------------------------------
.DS_Store
*.log
*.pyc
.build/
.buildlog/
.svn/

# ---------------------------------------------------------------------------
# Platform: macOS  (supported)
#
# macos/.gitignore and linux/.gitignore ship with `flutter create` and already
# cover ephemeral/, Pods/ and xcuserdata/ for those two folders, so only what
# they miss is listed here.
# ---------------------------------------------------------------------------
**/macos/Flutter/GeneratedPluginRegistrant.swift

# ---------------------------------------------------------------------------
# Platform: Linux  (supported)
# ---------------------------------------------------------------------------
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake

# ---------------------------------------------------------------------------
# Platforms not currently built, kept because `flutter create --platforms=...`
# adds the folders without updating this file.
# ---------------------------------------------------------------------------
