# Xcode, shared by the Apple platforms
**/Pods/
**/xcuserdata/

# Xcode writes per-user variants of these; only the defaults are shared.
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3

# Secrets. `env.json` holds the Finnhub API key and is passed to the build with
# --dart-define-from-file; it must never be committed. `env.example.json` is the
# committed template and holds no key.
env.json

